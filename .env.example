# Copie este arquivo para ".env" e preencha. O .env NAO vai para o GitHub.

# --- Banco Oracle da FIAP (deixe em branco para usar o banco local de demonstracao) ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=oracle.fiap.com.br:1521/ORCL

# --- IA generativa: preencha UMA das chaves (sem chave = modo simulado) ---
# Claude (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Gemini (Google AI Studio, tem cota gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Forcar um provedor: anthropic | gemini | simulado (vazio = automatico)
LLM_PROVIDER=
